SiiNunit
{
police_data : police.data
{
	# level based fines: min(base + level * step, limit), rounded up to multiple of rounding.
	fine_factor_base: 0.2
	fine_factor_step: 0.08
	fine_factor_limit: 1.0
	fine_amount_rounding: 20

	# speeding based progression: fine *= min( multiplier ^ (overspeed / step), limit), uses same rounding as above
	# DDE: kept at vanilla - severity stays vanilla, only detection fairness changes (see below)
	fine_overspeed_step: 2.777778
	fine_overspeed_step_multiplier: 1.877
	fine_overspeed_multiplier_limit: 12.5

	# DDE: base fine amounts kept at vanilla - breaking the rules should be expensive when it
	# actually happens; the fairness fix is in WHEN you get caught, not how much it costs
	fine_amounts[0]: 400		# car crash
	fine_amounts[1]: 500		# avoid mandatory break
	fine_amounts[2]: 100		# wrong way
	fine_amounts[3]: 200		# speeding (camera)
	fine_amounts[4]: 150		# no lights during night
	fine_amounts[5]: 350		# red lights
	fine_amounts[6]: 200		# speeding
	fine_amounts[7]: 700		# avoid weighing
	fine_amounts[8]: 1500		# illegal trailer
	fine_amounts[9]: 900		# avoid inspection
	fine_amounts[10]: 2000		# illegal border crossing
	fine_amounts[11]: 150		# hard shoulder violation
	fine_amounts[12]: 500		# damaged vehicle usage
	fine_amounts[13]: 1500		# illegal trailer (weight station)

	#
	# in seconds of real time - ambient (no police) check delay. Only relevant for offences
	# with nonzero ambient probability below; kept at vanilla for the rest (has no effect there).
	#
	offence_check_delay[0]: 0	# car crash
	offence_check_delay[1]: 60	# avoid mandatory break
	offence_check_delay[2]: 15	# wrong way
	offence_check_delay[3]: 0	# speeding (camera)
	offence_check_delay[4]: 70	# no lights during night
	offence_check_delay[5]: 0	# red lights
	offence_check_delay[6]: 60	# speeding
	offence_check_delay[7]: 0	# avoid weighing
	offence_check_delay[8]: 600	# illegal trailer

	#
	# in seconds of real time - delay before a nearby police car can flag the offence.
	# DDE: speeding and illegal-trailer delays loosened from vanilla's near-instant catch,
	# so a brief lapse doesn't get an instant ticket; mandatory-break delay matches the
	# Realistic Police Fines mod's more realistic logbook-check timing.
	#
	offence_police_check_delay[0]: 0	# car crash
	offence_police_check_delay[1]: 90	# avoid mandatory break - DDE: vanilla 30
	offence_police_check_delay[2]: 5	# wrong way
	offence_police_check_delay[3]: 0	# speeding (camera)
	offence_police_check_delay[4]: 7	# no lights during night
	offence_police_check_delay[5]: 0	# red lights
	offence_police_check_delay[6]: 15	# speeding - DDE: vanilla 3 (instant gotcha), mod 45
	offence_police_check_delay[7]: 0	# avoid weighing
	offence_police_check_delay[8]: 450	# illegal trailer - DDE: vanilla 300, mod 600

	# DDE: ambient (no police, no camera) detection chance - this is the "no magical fines" fix.
	# Zeroed for offences vanilla was fining with zero police/camera anywhere nearby; kept at
	# vanilla (or near it) for offences with a real fixed detection mechanism (camera, weigh
	# station, border checkpoint) since those aren't "magical" - they're real infrastructure.
	offence_probabilty[0]: 0.7	# car crash - unchanged, self-evident via damage
	offence_probabilty[1]: 0.0	# avoid mandatory break - DDE: vanilla 0.3, no police = no ticket
	offence_probabilty[2]: 0.0	# wrong way - DDE: vanilla 0.6
	offence_probabilty[3]: 0.95	# speeding (camera) - DDE: vanilla 1.0, cameras aren't infallible
	offence_probabilty[4]: 0.0	# no lights during night - DDE: vanilla 0.3
	offence_probabilty[5]: 0.3	# red lights - DDE: vanilla 0.7, simulates red-light cameras
	offence_probabilty[6]: 0.0	# speeding - unchanged
	offence_probabilty[7]: 1.0	# avoid weighing - unchanged, fixed infrastructure
	offence_probabilty[8]: 0.0	# illegal trailer - unchanged, no ambient detection mechanism
	offence_probabilty[9]: 1.0	# avoid inspection - unchanged, fixed checkpoint
	offence_probabilty[10]: 1.0	# illegal border crossing - unchanged, fixed checkpoint
	offence_probabilty[11]: 0.0	# hard shoulder violation - DDE: vanilla 1.0 (100% magical!)
	offence_probabilty[12]: 0.0	# damaged vehicle usage - DDE: vanilla 1.0 (100% magical!)
	offence_probabilty[13]: 1.0	# illegal trailer (weight station) - unchanged, fixed checkpoint

	# DDE: police-nearby detection chance - if a real cop is right there, they should usually
	# catch you. Raised above vanilla where ambient detection above was zeroed out, so those
	# offences keep real teeth through legitimate detection instead of ambient luck.
	offence_police_probabilty[0]: 1.0	# car crash - unchanged
	offence_police_probabilty[1]: 0.6	# avoid mandatory break - DDE: vanilla 0.3, raised
	offence_police_probabilty[2]: 0.9	# wrong way - DDE: vanilla 0.7, raised
	offence_police_probabilty[3]: 1.0	# speeding (camera) - unchanged
	offence_police_probabilty[4]: 0.8	# no lights during night - unchanged
	offence_police_probabilty[5]: 1.0	# red lights - unchanged
	offence_police_probabilty[6]: 0.9	# speeding - unchanged
	offence_police_probabilty[7]: 1.0	# avoid weighing - unchanged
	offence_police_probabilty[8]: 0.5	# illegal trailer - DDE: vanilla 0.3, raised
	offence_police_probabilty[9]: 1.0	# avoid inspection - unchanged
	offence_police_probabilty[10]: 1.0	# illegal border crossing - unchanged
	offence_police_probabilty[11]: 0.85	# hard shoulder violation - DDE: vanilla 1.0, slight softening
	offence_police_probabilty[12]: 0.7	# damaged vehicle usage - DDE: vanilla 1.0, softened
	offence_police_probabilty[13]: 1.0	# illegal trailer (weight station) - unchanged

	offence_message[0]: "@@offence_crash@@<color value=@@clr_sel@@>"	# car crash
	offence_message[1]: "@@offence_mandatory_break@@<color value=@@clr_sel@@>" 			# avoid mandatory break
	offence_message[2]: "@@offence_wrong_way@@<color value=@@clr_sel@@>" 				# wrong way
	offence_message[3]: "@@offence_speeding@@<color value=@@clr_sel@@>" 				# speeding (camera)
	offence_message[4]: "@@offence_lights@@<color value=@@clr_sel@@>" 					# no lights during night
	offence_message[5]: "@@offence_red_signal@@<color value=@@clr_sel@@>" 				# red lights
	offence_message[6]: "@@offence_speeding@@<color value=@@clr_sel@@>" 				# speeding
	offence_message[7]: "@@offence_weighing@@<color value=@@clr_sel@@>" 				# avoid weighing
	offence_message[8]: "@@offence_illegal_trailer@@<color value=@@clr_sel@@>" 			# illegal trailer
	offence_message[9]: "@@offence_avoid_inspection@@<color value=@@clr_sel@@>" 		# avoid inspection
	offence_message[10]: "@@offence_illegal_border@@<color value=@@clr_sel@@>" 			# illegal border crossing
	offence_message[11]: "@@offence_shoulder_violation@@<color value=@@clr_sel@@>" 		# hard shoulder violation
	offence_message[12]: "@@offence_damaged_vehicle_usage@@<color value=@@clr_sel@@>"	# damaged vehicle usage
	offence_message[13]: "@@offence_illegal_trailer@@<color value=@@clr_sel@@>" 		# illegal trailer (weight station)

	offence_icon[0]: "/material/ui/hud/car_crash.mat" 		# car crash
	offence_icon[1]: "/material/ui/time_skip_icons/mandatory_break_violation.mat" 		# avoid mandatory break
	offence_icon[2]: "/material/ui/hud/wrong_way.mat" 		# wrong way
	offence_icon[3]: "/material/ui/hud/speed_camera.mat" 	# speeding (camera)
	offence_icon[4]: "/material/ui/hud/head_lights.mat" 	# no lights during night
	offence_icon[5]: "/material/ui/hud/red_light.mat" 		# red lights
	offence_icon[6]: "/material/ui/hud/speed_camera.mat" 	# speeding
	offence_icon[7]: "/material/ui/hud/avoid_weighing.mat" 	# avoid weighing
	offence_icon[8]: "/material/ui/hud/illegal_trailer.mat" # illegal trailer
	offence_icon[9]: "/material/ui/hud/avoid_inspection.mat"# avoid inspection
	offence_icon[10]: "/material/ui/hud/avoid_inspection.mat" # illegal border crossing
	offence_icon[11]: "/material/ui/hud/eds.mat" 			# hard shoulder violation
	offence_icon[12]: "/material/ui/hud/damaged_vehicle.mat"# damaged vehicle usage
	offence_icon[13]: "/material/ui/hud/illegal_trailer.mat"# illegal trailer (weight station)

	# timer decrease rate how much time it takes to decrease timer by 1 second (in seconds of real time)
	# DDE: vanilla 120 - slightly longer so a rough patch doesn't compound into fine spam
	timer_decrease_rate: 150

	# increase fine if there is some police car nearby
	# DDE: kept at vanilla - full severity when a real patrol catches you
	police_nearby_fine_rate: 2.0

	# how often can nearby police car impose a fine
	# DDE: vanilla 15.0 - longer cooldown so a trailing cop can't fine you every 15 seconds
	police_nearby_offence_timer: 45.0
}
}
