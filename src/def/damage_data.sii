SiiNunit
{
vehicle_damage_data : .damage_data
{
	# damage dealt to truck and trailer

	truck_damage_coef:	0.0014		# DDE: 2x vanilla (0.0007) - crashes hit harder
	trailer_damage_coef:	0.0014		# DDE: 2x vanilla (0.0007)
	dragged_trailer_damage_coef: 0.00002	# damage coef for dragging improperly connected trailer
	truck_to_trailer_dmg: 	0.4		# DDE: 2x vanilla (0.2) - more damage transfers to the trailer

	side_damage_factor:	6.0
	roof_damage_factor:	11.0

	# damage distribution to truck parts

	cabin_damage_ratio:	0.8
	chassis_damage_ratio:	1.0
	engine_damage_ratio:	0.7		# DDE: vanilla 0.5
	transmission_damage_ratio: 0.5		# DDE: vanilla 0.3
	wheel_damage_ratio:	0.15

	# DDE: unfixable ratios raised 1.5x vanilla - a crash now leaves a permanent scar,
	# not just a repair bill, so reckless driving has a lasting cost
	cabin_unfixable_damage_ratio:	0.06	# vanilla 0.04
	chassis_unfixable_damage_ratio:	0.075	# vanilla 0.05
	engine_unfixable_damage_ratio:	0.03	# vanilla 0.02
	transmission_unfixable_damage_ratio: 0.015	# vanilla 0.01
	wheel_unfixable_damage_ratio:	0.015	# vanilla 0.01

	# damage distribution to trailer parts and cargo

	trailer_body_damage_ratio:	0.9	# DDE: vanilla 0.8
	trailer_chassis_damage_ratio:	1.0
	trailer_wheel_damage_ratio:	0.15

	trailer_body_unfixable_damage_ratio:	0.06	# DDE: vanilla 0.04
	trailer_chassis_unfixable_damage_ratio:	0.075	# DDE: vanilla 0.05
	trailer_wheel_unfixable_damage_ratio:	0.015	# DDE: vanilla 0.01

	cargo_damage_ratio: 1.0

	# truck wear per km of drive

	cabin_wear:		2e-7		# DDE: vanilla 0.0 - mileage now puts light wear on the cab
	chassis_wear:		1e-7		# DDE: vanilla 0.0 - mileage now puts light wear on the frame
	engine_wear:		4e-8		# DDE: vanilla 2e-6
	transmission_wear:	3e-7		# DDE: vanilla 2e-6
	wheel_wear:		2e-6		# unchanged from vanilla

	# unfixable (permanent) wear stays at vanilla - routine mileage attrition isn't
	# "reckless driving", so it shouldn't compound the crash penalties above
	cabin_wear_unfixable:		0.0	# mileage wear on cabin stays fully fixable via service
	chassis_wear_unfixable:		0.0	# mileage wear on chassis stays fully fixable via service
	engine_wear_unfixable:		2e-7
	transmission_wear_unfixable:	2e-7
	wheel_wear_unfixable:		2e-5

	# trailer wear per km of drive

	# DDE: vanilla 0.0 - an owned trailer's running cost (upkeep + depreciation, not just
	# mechanical wear), paid for by the Cargo Market premium in economy_data.sii. Same rate on
	# body and chassis so the repair bill follows the trailer's price: an 80k reefer costs ~3x
	# a 25k curtainsider per km. 1% per 1000 km - a conservative first value, playtest-calibrated.
	# Far above the truck's cab/chassis rates on purpose: those are maintenance flavor only.
	trailer_body_wear:	1e-5
	trailer_chassis_wear:	1e-5
	trailer_wheel_wear:	2e-6		# unchanged from vanilla

	trailer_body_wear_unfixable:		0.0
	trailer_chassis_wear_unfixable:		0.0
	trailer_wheel_wear_unfixable:		2e-5
}
}
